# Canonical site URL for sitemap, Open Graph, and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://himosoft.com.bd

# Optional: Google Search Console HTML tag verification value
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Optional: Bing Webmaster Tools verification value (msvalidate.01)
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code

# Live chat via OpenRouter (server-only — never expose in NEXT_PUBLIC_*)
OPENROUTER_API_KEY=
# Optional model id (default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini
